# 安羅夕雅OS — environment configuration
# Copy this file to .env.local and fill in the values you have.
# Every integration below is optional: the app runs fully offline using a local
# JSON data store and rule-based AI fallbacks when these are not set.

# --- AI (daily tasks + AI監督 coaching messages) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional secondary provider (not required; Claude is primary)
OPENAI_API_KEY=

# --- Supabase (optional persistent backend) ---
# When both are set, wire lib/db/repo.ts functions to lib/db/supabase.ts
# (see supabase/schema.sql for the table definitions). Without them, data
# persists to ./data/store.json on the local filesystem.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Real video analysis microservice (optional) ---
# A deployed MediaPipe/OpenCV service (see scripts/pose_analysis/) that
# src/app/api/video-analysis/route.ts will call instead of the built-in
# heuristic simulation. Must expose POST {url}/analyze accepting
# multipart/form-data with `file` and `type` (squat|match).
VIDEO_ANALYSIS_SERVICE_URL=
